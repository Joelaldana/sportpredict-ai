# Server secret: keep this out of Git and never expose it with VITE_.
GEMINI_API_KEY=

# Optional server-side football provider key.
FOOTBALL_DATA_API_KEY=

# Public AdSense publisher/client ID. This is not a secret.
# Configure it only after Google gives you the real ca-pub-... ID.
VITE_ADSENSE_CLIENT_ID=

# Optional local/server settings. Render supplies PORT automatically.
NODE_ENV=development
PORT=3000
